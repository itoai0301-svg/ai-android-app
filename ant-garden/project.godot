; Ant Meadow — Android native Godot game
config_version=5

[application]
config/name="Ant Meadow"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A little garden adventure. Gather food and bring it home."
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.06,0.18,0.13,1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
limits/opengl/max_lights_per_object=4
limits/opengl/max_renderable_lights=8
environment/defaults/default_clear_color=Color(0.57, 0.68, 0.49, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[audio]
driver/enable_input=false

